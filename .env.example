# STTNS — configuration locale (Supabase lancé par `supabase start`).
# Copier en .env.local, puis recopier les deux clés affichées par `supabase status -o env`
# (ANON_KEY et SERVICE_ROLE_KEY). Ne jamais commiter .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Fonctionnalités optionnelles (masquées par défaut)
# NEXT_PUBLIC_STTNS_BRAINSTORMING=true
# NEXT_PUBLIC_STTNS_MODULES=true

# Développement local uniquement : entrer dans l'appli sans mot de passe (ignoré si Supabase
# ou la requête ne sont pas sur localhost). Compte utilisé : STTNS_LOCAL_LOGIN_EMAIL.
STTNS_LOCAL_LOGIN=1
STTNS_LOCAL_LOGIN_EMAIL=claire.morel@panier-local.test
